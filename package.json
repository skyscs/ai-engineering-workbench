{
  "name": "ai-engineering-workbench",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @aew/daemon --filter @aew/web dev",
    "build": "pnpm --filter @aew/web build && pnpm --filter @aew/daemon build && pnpm --filter './packages/**' build",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @aew/daemon start"
  }
}
