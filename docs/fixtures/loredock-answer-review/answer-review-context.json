      "endLine": 7,
      "contentHash": "161e949a54ab2ab99648cd5dd07de4c4115d554d411e85dfc919412877e00a5e",
      "spanHash": "bf02b9ad422fda91b66ace23870e9d0b142f550071231acbd668eb3c439b833d",
      "text": "{\n  \"routes\": [\n    { \"method\": \"POST\", \"path\": \"/api/orders\", \"handler\": \"Orders.accept\" },\n    { \"method\": \"POST\", \"path\": \"/legacy/orders\", \"handler\": \"Orders.accept\" }\n  ],\n  \"headerBindings\": { \"Orders.accept.tenantId\": \"X-Tenant\" }\n}"
    }
